# Public URL of the site (used for Stripe return links)
APP_URL=http://localhost:3000

# Comma-separated emails that get the admin dashboard when they sign up / log in
ADMIN_EMAILS=you@example.com

# Secret your back-end agents send as "Authorization: Bearer <key>"
AGENT_API_KEY=change-me-to-a-long-random-string

# Which agent quotes wait for staff approval before the customer sees them:
# custom (default) = custom-design requests only, all = every agent quote, none = no approval step
# QUOTE_APPROVAL=custom

# Stripe. Leave blank in development to use the built-in simulated checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Where the SQLite database and uploaded files live (default: ./data)
# DATA_DIR=/var/lib/squiggle

# Outgoing email (password reset links). Any SMTP provider works.
# Until this is set, emails are written to the server log instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Squiggle <hello@your-domain.com>"
