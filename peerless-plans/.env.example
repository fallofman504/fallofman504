# Public URL of the site (used for Stripe return links and the links in emails)
APP_URL=http://localhost:3000

# Passcode for the review queue at /admin. The queue stays closed until this is set.
ADMIN_PASSCODE=

# Your name as it appears in the title block. Prefills the "Checked by" box at sign-off.
FOUNDER_NAME=

# Where "new order" and "sign-off needed" notices go
ADMIN_EMAIL=

# Secret your drafting agents send as "Authorization: Bearer <key>"
AGENT_API_KEY=change-me-to-a-long-random-string

# Stripe. Leave blank in development to use the built-in simulated checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Where the SQLite database and uploaded files live (default: ./data)
# DATA_DIR=/var/lib/peerless

# Outgoing email (order links, "preview ready", "files ready"). Any SMTP provider works.
# Until this is set, emails are written to the server log instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Peerless Plans <hello@your-domain.com>"

# Production only (docker compose)
# CLOUDFLARE_TUNNEL_TOKEN=
# PEERLESS_DATA_DIR=/var/lib/peerless
